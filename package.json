{
  "name": "moderntavern-prototype",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": "1.3.13"
  },
  "scripts": {
    "dev": "bun --bun node_modules/nuxt/bin/nuxt.mjs dev --host 127.0.0.1",
    "build": "bun --bun node_modules/nuxt/bin/nuxt.mjs build",
    "preview": "bun .output/server/index.mjs",
    "postinstall": "bun --bun node_modules/nuxt/bin/nuxt.mjs prepare",
    "typecheck": "bun scripts/typecheck.cjs",
    "test": "bun test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vueuse/core": "^12.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.482.0",
    "markdown-it": "^14.1.0",
    "nuxt": "4.1.3",
    "reka-ui": "^2.5.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/bun": "^1.3.13",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.9.3",
    "vue-tsc": "2.2.12"
  }
}
